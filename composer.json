{
    "name": "schachbulle/contao-metadaten-bundle",
    "type": "contao-bundle",
    "description": "Backend-Modul für Contao 4.13 und 5: Metadaten von Dateien (Titel, Alternativtext, Link, Bildunterschrift, Lizenz) gesammelt suchen, ersetzen oder setzen.",
    "keywords": [
        "contao",
        "metadaten",
        "metadata",
        "dateiverwaltung",
        "bildunterschrift",
        "suchen und ersetzen",
        "backend"
    ],
    "homepage": "https://github.com/Samson1964/contao-metadaten-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.7"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.5 || ^10.0"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoMetadatenBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoMetadatenBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoMetadatenBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-metadaten-bundle/issues",
        "source": "https://github.com/Samson1964/contao-metadaten-bundle"
    }
}
