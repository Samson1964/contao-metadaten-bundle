<?php
/**
 * Backend-Template der Vorschauseite eines Auftrags (key=vorschau).
 *
 * Wird von Modules\Metadaten::vorschau() befüllt. Die Texte kommen aus
 * $GLOBALS['TL_LANG']['METADATEN'] (hier als $this->texte), die
 * Feldbezeichnungen aus Contaos eigener Sprachdatei (MSC.aw_*).
 *
 * Alles Sichtbare steht in .widget-Blöcken, damit die Abstände aus Contaos
 * Backend-Stylesheet kommen. Ausgaben werden mit StringUtil::specialchars()
 * maskiert, weil Pfade, Suchtexte und Metadaten Benutzereingaben sind.
 */

use Contao\StringUtil;

$t = $this->texte;
$sc = static function ($wert): string { return StringUtil::specialchars((string) $wert); };
?>
<div id="tl_buttons">
	<a href="<?= $this->zurueck ?>" class="header_back" title="<?= $sc($GLOBALS['TL_LANG']['MSC']['backBTTitle'] ?? '') ?>" accesskey="b"><?= $GLOBALS['TL_LANG']['MSC']['backBT'] ?? 'Zurück' ?></a>
	<a href="<?= $this->bearbeiten ?>" class="header_edit" title="<?= $sc($t['bearbeiten'] ?? 'Auftrag bearbeiten') ?>"><?= $sc($t['bearbeiten'] ?? 'Auftrag bearbeiten') ?></a>
</div>

<h2 class="sub_headline"><?= $sc(sprintf($t['headline'] ?? 'Vorschau: %s', $this->titel)) ?></h2>

<?= $this->meldungen ?>

<form id="<?= $this->formular ?>" class="tl_form tl_edit_form" method="post" action="<?= $this->action ?>">
<div class="tl_formbody_edit">
	<input type="hidden" name="FORM_SUBMIT" value="<?= $this->formular ?>">
	<input type="hidden" name="REQUEST_TOKEN" value="<?= $this->requestToken ?>">

	<fieldset class="tl_tbox">
		<legend><?= $sc($t['legendAuftrag'] ?? 'Auftrag') ?></legend>
		<div class="widget clr metadaten-zusammenfassung">
			<table>
				<?php foreach ($this->zusammenfassung as $zeile): ?>
					<tr>
						<th><?= $sc($zeile['label']) ?></th>
						<td><?= '' !== $zeile['wert'] ? $sc($zeile['wert']) : '<span class="tl_gray">–</span>' ?></td>
					</tr>
				<?php endforeach; ?>
			</table>
		</div>
	</fieldset>

	<?php if ($this->ergebnis): ?>
		<fieldset class="tl_box">
			<legend><?= $sc($t['legendErgebnis'] ?? 'Ausgeführt') ?></legend>
			<div class="widget clr">
				<p class="tl_info"><?= $sc(sprintf($t['ergebnisListe'] ?? '%d Dateien:', \count($this->ergebnis))) ?></p>
				<ul class="metadaten-dateiliste">
					<?php foreach ($this->ergebnis as $pfad): ?>
						<li><?= $sc($pfad) ?></li>
					<?php endforeach; ?>
				</ul>
			</div>
		</fieldset>
	<?php endif; ?>

	<?php if (null !== $this->vorschau): ?>
		<fieldset class="tl_box metadaten-vorschau">
			<legend><?= $sc($t['legendVorschau'] ?? 'Vorschau der Änderungen') ?></legend>

			<?php if (0 === $this->vorschau['anzahl']): ?>
				<div class="widget clr">
					<p class="tl_info"><?= $sc(sprintf($t['keineTreffer'] ?? 'Keine Änderungen in %d Dateien.', $this->vorschau['gesamt'])) ?></p>
				</div>
			<?php else: ?>
				<div class="widget clr">
					<p class="tl_info"><?= $sc(sprintf($t['treffer'] ?? '%d von %d Dateien werden geändert.', $this->vorschau['anzahl'], $this->vorschau['gesamt'])) ?></p>
					<?php if ($this->vorschau['gekuerzt']): ?>
						<p class="tl_help"><?= $sc(sprintf($t['gekuerzt'] ?? 'Es werden nur die ersten %d Dateien angezeigt.', \count($this->vorschau['zeilen']))) ?></p>
					<?php endif; ?>
				</div>

				<div class="widget clr metadaten-tabelle">
					<table class="tl_listing">
						<thead>
							<tr>
								<th class="tl_folder_tlist"><?= $sc($t['spalteDatei'] ?? 'Datei') ?></th>
								<th class="tl_folder_tlist"><?= $sc($t['spalteSprache'] ?? 'Sprache') ?></th>
								<th class="tl_folder_tlist"><?= $sc($t['spalteFeld'] ?? 'Feld') ?></th>
								<th class="tl_folder_tlist"><?= $sc($t['spalteAlt'] ?? 'bisher') ?></th>
								<th class="tl_folder_tlist"><?= $sc($t['spalteNeu'] ?? 'neu') ?></th>
							</tr>
						</thead>
						<tbody>
							<?php foreach ($this->vorschau['zeilen'] as $zeile): ?>
								<?php foreach ($zeile['unterschiede'] as $i => $u): ?>
									<tr>
										<td class="tl_file_list"><?= 0 === $i ? $sc($zeile['path']) : '' ?></td>
										<td class="tl_file_list"><?= $sc($u['sprache']) ?></td>
										<td class="tl_file_list"><?= $sc($this->felder[$u['feld']] ?? $u['feld']) ?></td>
										<td class="tl_file_list metadaten-alt"><?= $sc($u['alt']) ?></td>
										<td class="tl_file_list metadaten-neu"><?= $sc($u['neu']) ?></td>
									</tr>
								<?php endforeach; ?>
							<?php endforeach; ?>
						</tbody>
					</table>
				</div>
			<?php endif; ?>
		</fieldset>
	<?php endif; ?>
</div>

<?php if (null !== $this->vorschau && $this->vorschau['anzahl'] > 0): ?>
	<div class="tl_formbody_submit">
		<div class="tl_submit_container">
			<button type="submit" name="ausfuehren" id="ausfuehren" class="tl_submit metadaten-ausfuehren" value="1" accesskey="s"><?= $sc(sprintf($t['ausfuehren'] ?? '%d Dateien jetzt ändern', $this->vorschau['anzahl'])) ?></button>
		</div>
	</div>
<?php endif; ?>
</form>
